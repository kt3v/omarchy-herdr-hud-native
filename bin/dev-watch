#!/usr/bin/env bash
# Dev helper: restart the Omarchy shell after source changes.
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
events=close_write,create,delete,move

command -v inotifywait >/dev/null 2>&1 || {
  echo "dev-watch: inotifywait not found (install inotify-tools)" >&2
  exit 1
}

exec 9<"$repo_dir/bin/dev-watch"
flock --nonblock 9 || {
  echo "dev-watch: another watcher is already running" >&2
  exit 1
}

omarchy-shell shell ping >/dev/null

matches_source() {
  case "$1" in
  *.qml | *.js | */manifest.json | */qmldir) return 0 ;;
  *) return 1 ;;
  esac
}

echo "Watching $repo_dir - restarts Omarchy shell after saves; Ctrl-C to stop."

coproc source_events {
  exec inotifywait --monitor --recursive --quiet --format '%w%f' \
    --exclude '/(\.git|\.agents|\.codex|__pycache__)/' \
    --event "$events" "$repo_dir"
}
watch_pid=$source_events_PID
exec {event_fd}<&"${source_events[0]}"
trap 'kill "$watch_pid" 2>/dev/null || true; wait "$watch_pid" 2>/dev/null || true' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

while IFS= read -r -u "$event_fd" path; do
  matches_source "$path" || continue
  while IFS= read -r -t 0.5 -u "$event_fd" next_path; do
    if matches_source "$next_path"; then path=$next_path; fi
  done
  echo "restart: ${path#"$repo_dir"/}"
  if omarchy restart shell; then
    echo "dev-watch: shell restarted"
  else
    echo "dev-watch: shell restart failed" >&2
  fi
done
echo "dev-watch: file watcher stopped unexpectedly" >&2
exit 1
