#!/usr/bin/env python3
"""Exercise the actual HUD panel using only owned, harmless Herdr fixtures."""
import argparse
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import tempfile
import time

ROOT = Path(__file__).resolve().parents[1]
from live_helpers import cli, events, Stream

def run(args):
    if os.environ.get("HERDR_ENV") != "1":
        raise RuntimeError("Run inside Herdr; this test creates and cleans up two disposable panes")
    panes = []
    with tempfile.TemporaryDirectory(prefix="herdr-native-live-") as directory:
        temp = Path(directory)
        (temp / "Commons").symlink_to("/usr/share/omarchy/shell/Commons")
        (temp / "Ui").symlink_to("/usr/share/omarchy/shell/Ui")
        shutil.copytree(ROOT, temp / "plugin", ignore=shutil.ignore_patterns("tests", "__pycache__"))
        shutil.copyfile(ROOT / "tests/native_panel.qml", temp / "shell.qml")
        theme = Path.home() / ".local/state/omarchy/current/theme"
        if theme.exists():
            isolated_theme = temp / ".local/state/omarchy/current/theme"
            isolated_theme.parent.mkdir(parents=True)
            isolated_theme.symlink_to(theme.resolve())
        records = []
        try:
            for index in range(2):
                pane = cli("pane", "split", "--current", "--direction", "right", "--cwd", str(ROOT), "--no-focus")["pane"]
                panes.append(pane)
                record = temp / f"events-{index}.jsonl"
                records.append(record)
                command = shlex.join(["exec", "python3", str(ROOT / "tests/terminal_fixture.py"), str(record), "--seconds", "100"])
                cli("pane", "run", pane["pane_id"], command)
                deadline = time.monotonic() + 5
                while not events(record) and time.monotonic() < deadline:
                    time.sleep(0.1)
                assert events(record)[0]["type"] == "ready", "fixture ready"
            env = dict(os.environ, HOME=directory, QT_QPA_PLATFORM="wayland", QT_QPA_PLATFORMTHEME="", QT_QUICK_BACKEND="software",
                       HERDR_NATIVE_TARGET=panes[0]["terminal_id"], HERDR_NATIVE_OTHER=panes[1]["terminal_id"])
            if args.qml_import_path:
                env["QML_IMPORT_PATH"] = str(args.qml_import_path.resolve())
            if args.screenshots:
                args.screenshots.mkdir(parents=True, exist_ok=True)
                env["HERDR_NATIVE_SCREENSHOTS"] = str(args.screenshots.resolve())
            result = subprocess.run(["quickshell", "--no-color", "-p", str(temp / "shell.qml")], env=env, capture_output=True, text=True, timeout=65)
            output = result.stdout + result.stderr
            print(output, flush=True)
            for record in records:
                print(json.dumps({"fixture": record.name, "events": events(record)}, ensure_ascii=False), flush=True)
            assert result.returncode == 0 and "NATIVE_TEST_COMPLETE" in output and "NATIVE_FAIL" not in output, "native panel acceptance"
            assert "ReferenceError" not in output and "TypeError" not in output and "Binding loop" not in output, "QML runtime errors"
            commands = [event["text"] for event in events(records[0]) if event["type"] == "command"]
            assert all(text in commands for text in ("1", "2", "3", "yes", "no", "\x1b", "alt", "normal")), commands
            assert "SECOND_ONLY" not in commands, "input routed to wrong agent"
            assert "SECOND_ONLY" in [event["text"] for event in events(records[1]) if event["type"] == "command"]
            assert not any(text == "q" or "\x02" in text for text in commands), "detach injected text into fixture"
            for pane, record in zip(panes, records):
                os.kill(events(record)[0]["pid"], 0)
                assert not any(event["type"] == "exit" for event in events(record)), "fixture survived"
                owner = Stream(pane["terminal_id"], "control")
                try:
                    assert owner.next()["type"] == "terminal.frame", "hidden panel released controller"
                finally:
                    owner.close()
            print(json.dumps({"status": "passed", "commands": commands, "panes": len(panes)}))
        finally:
            for pane in reversed(panes):
                cli("pane", "close", pane["pane_id"])

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run-live", action="store_true", required=True)
    parser.add_argument("--qml-import-path", type=Path)
    parser.add_argument("--screenshots", type=Path)
    run(parser.parse_args())
